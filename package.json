{
  "name": "rizzova-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute rizzova-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute rizzova-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241218.0",
    "typescript": "5.7.2",
    "wrangler": "3.99.0"
  }
}
